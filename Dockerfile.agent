# CTF-solver agent sandbox. One container = the agent's execution env.
# Kali base: ~+9.5% solve rate vs Ubuntu for the same model (arXiv 2605.28334).
# ponytail: single fat image for all categories. Split per-agent images only if
# cold-start or size actually hurts.
FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev pipx git curl wget jq \
    build-essential cmake pkg-config ruby ruby-dev golang cargo \
    # headers for gmpy2/psutil/pwntools/unicorn native builds
    libgmp-dev libmpfr-dev libmpc-dev libssl-dev libffi-dev \
    # rev/pwn
    gdb binutils file ltrace strace radare2 \
    # forensics
    exiftool binwalk foremost p7zip-full poppler-utils tshark \
    # crypto/pw cracking + wordlist
    hashcat john fcrackzip pdfcrack wordlists \
    && rm -rf /var/lib/apt/lists/*
RUN gunzip -kf /usr/share/wordlists/rockyou.txt.gz 2>/dev/null || true
ENV WORDLIST=/usr/share/wordlists/rockyou.txt
# ponytail: SageMath deferred — no reliable Kali apt package, and it's ~2GB.
# sympy+pycryptodome+z3 cover most crypto; add via the sagemath/sagemath image
# (or conda) only when a lattice/DLog challenge actually needs it.

# --- crypto ---
RUN pip3 install --break-system-packages \
    pycryptodome sympy z3-solver factordb-python xortool
RUN git clone --depth 1 https://github.com/RsaCtfTool/RsaCtfTool /opt/RsaCtfTool \
    && pip3 install --break-system-packages -r /opt/RsaCtfTool/requirements.txt

# --- rev / pwn ---
# core pwn (must succeed); ROPgadget/ropper best-effort — their dep filebytes
# uses ast.Str, removed in py3.12+ (Kali py3.13). pwntools' own ROP() + one_gadget
# cover ROP-chaining without them.
RUN pip3 install --break-system-packages pwntools angr r2pipe
RUN pip3 install --break-system-packages ROPgadget ropper || echo "ropgadget/ropper skipped (py3.13 filebytes incompat)"
RUN gem install one_gadget || true
# pwndbg for interactive GDB (also exposed via pwndbg-mcp on the host side)
RUN git clone --depth 1 https://github.com/pwndbg/pwndbg /opt/pwndbg \
    && cd /opt/pwndbg && ./setup.sh || true

# --- web --- (each tool best-effort so one failure doesn't sink the image)
RUN pip3 install --break-system-packages httpx requests sqlmap arjun || true
RUN go install github.com/ffuf/ffuf/v2@latest || true
RUN go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest || true
RUN git clone --depth 1 https://github.com/ticarpi/jwt_tool /opt/jwt_tool || true; \
    git clone --depth 1 https://github.com/vladko312/SSTImap /opt/SSTImap || true
RUN pip3 install --break-system-packages playwright && playwright install --with-deps chromium || \
    echo "playwright skipped"

# --- forensics --- (binwalk already installed via apt; skip slow cargo build)
RUN pip3 install --break-system-packages volatility3 yara-python pefile oletools || true
RUN gem install zsteg || true
# stegseek: grab release .deb
RUN wget -q https://github.com/RickdeJager/stegseek/releases/latest/download/stegseek_0.6-1.deb \
    -O /tmp/stegseek.deb && apt-get install -y /tmp/stegseek.deb || true

# --- osint (challenge-scoped targets ONLY; enforce in agent prompt) ---
RUN pipx install maigret && pipx install sherlock-project && pipx install theHarvester || \
    pip3 install --break-system-packages maigret sherlock-project theHarvester

ENV PATH="/root/go/bin:/root/.cargo/bin:${PATH}"
WORKDIR /work
